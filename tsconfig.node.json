{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "src/features/data-exchange/afsim-event-log.ts",
    "src/features/data-exchange/local-monitor.ts",
    "src/features/situation/initial-nodes.ts",
    "src/features/situation/file-communication-links.ts",
    "src/features/situation/position-updates.ts",
    "src/features/replays/local-replay.ts",
    "src/features/data-exchange/csv-contract.ts",
    "src/features/scenarios/scenario-validation.ts",
    "src/features/scenarios/scenario-basic.ts",
    "src/features/scenarios/link-settings.ts",
    "src/features/scenarios/jammer-settings.ts",
    "src/features/admin/admin-contract.ts",
    "src/features/admin/audit-labels.ts",
    "src/features/shared/date-time.ts"
  ]
}
