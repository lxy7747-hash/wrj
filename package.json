{
  "name": "wrj-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview:ui": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "dev:mock": "npm run validate:contracts && tsx server/local.ts",
    "start:mock": "npm run validate:contracts && tsx server/local.ts",
    "build": "vite build",
    "build:lan": "vite build --mode lan && vite build --config vite.server.config.ts",
    "start:lan": "node --env-file=.env.server scripts/start-lan.mjs",
    "start:server": "node --env-file=.env.server server-dist/server.mjs",
    "start:tiles": "node --env-file=.env.server scripts/start-tiles.mjs",
    "typecheck": "tsc -b",
    "validate:contracts": "tsx scripts/validate-contracts.ts",
    "test:unit": "vitest run --config vitest.config.ts tests/components tests/stores",
    "test:contracts": "vitest run --config vitest.config.ts tests/contracts",
    "test:server": "vitest run --config vitest.config.ts tests/server",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release-check.mjs",
    "test": "npm run test:unit && npm run test:contracts && npm run test:server",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --no-file-parallelism --coverage.reporter=text",
    "p0:check": "npm run typecheck && npm run build && npm run validate:contracts && npm run test:unit && npm run test:contracts && npm run test:server && npm run test:coverage"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "element-plus": "2.14.5",
    "express": "5.1.0",
    "leaflet": "1.9.4",
    "leaflet.vectorgrid": "1.3.0",
    "pbf": "5.1.2",
    "pinia": "4.0.3",
    "vue": "3.5.21",
    "vue-router": "4.6.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "5.0.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
