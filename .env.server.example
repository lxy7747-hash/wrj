# 复制为 .env.server，修改为服务器实际地址和绝对路径。不要提交 .env.server。
# Node.js 使用 --env-file 加载；内网模式不会再读取开发机的 .env.local。
WRJ_DEPLOYMENT=lan
WRJ_PUBLIC_ORIGIN=http://192.168.1.10:8080
WRJ_HOST=0.0.0.0
WRJ_PORT=8080
WRJ_WEB_ROOT=C:/wrj/app/dist
WRJ_OUTPUT_ROOT=C:/wrj/output
SCENARIO_DB_PATH=C:/wrj/data/scenarios.db
MISSION_EXECUTABLE_PATH=C:/wrj/engine/mission.exe
# 同任务保持单实例；不同任务可配置1至4个并行运行。真实引擎许可/资源未验证前保持1。
MISSION_MAX_PARALLEL_TASKS=1
# 单次 mission 墙钟运行超时（秒），0 或留空不启用；超时后自动终止进程树并记录原因
MISSION_RUN_TIMEOUT_SECONDS=0
# 可选：同一场仿真的外部引擎链路帧；留空不启用，仅支持一个运行绑定。
# LINK_ENGINE_WS_URL=ws://192.168.1.49:8080/ws/v1
# 仅验证网页服务时可设置 WRJ_WEB_ONLY=1，并删除上面的 MISSION_EXECUTABLE_PATH；仿真启动会明确失败。
# WRJ_WEB_ONLY=1

# 地图服务只监听本机；地图文件必须保留以下文件名，对应浏览器的固定资源标识。
WRJ_MAP_PORT=4174
WRJ_MAP_EXECUTABLE_PATH=C:/wrj/tools/versatiles.exe
WRJ_MAP_VECTOR_PATH=C:/wrj/maps/china-taiwan-260823.pmtiles
WRJ_MAP_SATELLITE_PATH=C:/wrj/maps/taiwan-strait-satellite.pmtiles

# 全新账号库首次启动需要 12–128 位管理员密码；已有账号库不要重新初始化。
# AUTH_BOOTSTRAP_PASSWORD=填写新的管理员密码

# 可选：当前态势/回放/报告读取的文件；留空时明确显示未配置。
# 这一批改造不自动把新仿真的独占输出绑定到这两个入口。
# AFSIM_EVENT_LOG_PATH=C:/wrj/input/scenario_events.csv
# AFSIM_POSITION_LOG_PATH=C:/wrj/input/position.csv
# PDF 导出会嵌入此字体；非 Windows 或不使用系统中文字体时必须配置可嵌入的 TTF 或 OTF。
# WRJ_PDF_FONT_PATH=C:/wrj/fonts/NotoSansSC-Regular.ttf
