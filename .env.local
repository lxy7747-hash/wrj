# 本机开发/联调的唯一配置文件，随 Git 共享；不再需要 .env.example。
# 其他电脑只需修改下面四个绝对路径；数据库目录须已存在，不会自动复制运行数据。
# 密码、令牌和 AUTH_BOOTSTRAP_PASSWORD 通过进程环境提供，不写入此文件。

# AFSIM 事件日志的只读来源。
AFSIM_EVENT_LOG_PATH=H:/Project/newWrj/output/scenario_events.csv
# AFSIM 持续追加的位置文件；仅处理以换行结束的完整记录。
AFSIM_POSITION_LOG_PATH=H:/Project/newWrj/output/position.csv
# 普通 SQLite 未加密，仅用于非敏感测试数据；文件路径必须为绝对路径。
SCENARIO_DB_PATH=H:/Project/newWrj/data/scenarios.db
# mission 可执行文件的绝对路径；修改后重启 Node.js 后端生效。
# 连接 WebSocket 时不启动 mission；本机执行时按已保存场景生成独立运行包，不覆盖原 CSV。
MISSION_EXECUTABLE_PATH=H:/Project/newWrj/Release/Release/mission.exe

# 引擎数据源：true 连接真实引擎，false 启动本机模拟引擎；修改后重启后端。
useRealEngine=false
# 真实引擎 WebSocket 地址，仅 useRealEngine=true 时使用；外部环境变量 LINK_ENGINE_WS_URL 可覆盖。
# 浏览器经本项目后端转发，不直接连接真实引擎。
realUrl=ws://192.168.1.48:8080/ws/v1
# 本机模拟引擎推送间隔，单位毫秒（5000 毫秒 = 5 秒，最小 100）；仅 useRealEngine=false 时使用。
mockIntervalMs=5000
