# 本机开发/联调的唯一配置文件，随 Git 共享；已取代旧的开发版 .env.example。
# 内网/服务器部署另用 .env.server.example（复制为 .env.server），与本文件互斥加载，二者不重复。
# 其他电脑只需修改下面四个绝对路径；数据库目录须已存在，不会自动复制运行数据。
# 密码、令牌和 AUTH_BOOTSTRAP_PASSWORD 通过进程环境提供，不写入此文件。

# AFSIM 事件日志的只读来源。
AFSIM_EVENT_LOG_PATH=H:/Project/newWrj/output/scenario_events.csv
# AFSIM 持续追加的位置文件；仅处理以换行结束的完整记录。
AFSIM_POSITION_LOG_PATH=H:/Project/newWrj/output/position.csv
# 普通 SQLite 未加密，仅用于非敏感测试数据；文件路径必须为绝对路径。
SCENARIO_DB_PATH=H:/Project/newWrj/data/scenarios.db
# mission 可执行文件的绝对路径；修改后重启 Node.js 后端生效。
# 本机执行时按已保存场景启动 mission 并生成独立运行包，不覆盖原 CSV。
MISSION_EXECUTABLE_PATH=H:/Project/newWrj/frontend/Release/Release/mission.exe
# 本地 mission 运行包内的事件/位置输出子目录（相对运行包，不能是绝对路径）；留空=沿用场景 output.directory（默认 output）。
# WRJ_MISSION_OUTPUT_DIR=output
# 运行输出根目录（运行包/结果/引擎帧/报告等）；必须是绝对路径；留空=frontend/output。
WRJ_OUTPUT_ROOT=H:/Project/newWrj/frontend/Release/output
# 可选：场景配置“生成脚本”产生的 TXT 模板包输出目录；留空=frontend/output/scripts，必须是绝对路径。
# WRJ_SCRIPT_OUTPUT_ROOT=H:/Project/newWrj/output/scripts

# 任务执行方式：local 优先于下面的引擎选择，在本机启动 mission.exe；auto 沿用引擎选择。
WRJ_MISSION_MODE=local
WRJ_LINK_CALC_MODE=auto

# 引擎数据源：true 连接外部引擎，false 关闭外部连接（本机 mission 照常执行）；修改后重启后端。
useRealEngine=true
# 本机插件 IP 统一在下面 realUrl 中修改（同机运行保持 127.0.0.1 即可）。
# useRealEngine=true 且 WRJ_LINK_CALC_MODE=auto 时，重启后端自动同步 mission 旁 CalcConfig.ini 的 wsip/wsport/wspath。
# 本机同步支持 ws:// + 本机 IPv4/localhost；修改前先停止仿真。远程地址不会改写本机插件配置。
# 留空默认 ws://127.0.0.1:8080/ws/v1；部署启动器仍按 deployment.env 的 DEPLOY_HOST 设置地址。
# 仅 useRealEngine=true 时使用；外部环境变量 LINK_ENGINE_WS_URL 可显式覆盖。
# 浏览器经本项目后端转发，不直接连接真实引擎。
realUrl=ws://127.0.0.1:8080/ws/v1
# 本机模拟引擎推送间隔，单位毫秒（5000 毫秒 = 5 秒，最小 100）；仅 useRealEngine=false 时使用。
mockIntervalMs=5000
