# 仅本机开发入口读取；不配置则保留原有纯内存场景和模板。
# 普通 SQLite 未加密，仅用于非敏感测试数据；目录必须已存在，路径必须为绝对路径。
SCENARIO_DB_PATH=C:/wrj-data/scenarios.db
# 可选；不配置时使用 frontend 同级 Release/Release/mission.exe。
# 开始时以已保存场景重新生成独占执行包，输出位于 frontend/output/mission-runs/，不覆盖原 CSV。
# MISSION_EXECUTABLE_PATH=C:/wrj/Release/Release/mission.exe
# 引擎数据源：true 连接真实引擎，false 启动本机模拟引擎；修改后重启后端。
useRealEngine=true
# 真实引擎 WebSocket 地址，仅 useRealEngine=true 时使用；外部环境变量 LINK_ENGINE_WS_URL 可覆盖。
# 本服务连接引擎，浏览器不直连；点击页面“播放”建立连接，不启动本机 mission.exe。
realUrl=ws://192.168.1.48:8080/ws/v1
# 本机模拟引擎推送间隔，单位毫秒（5000 毫秒 = 5 秒，最小 100）；仅 useRealEngine=false 时使用。
mockIntervalMs=5000
